# For calculation questions, modify the values and run the command to get answers
# Round to hundredths as needed

# ============================================================================
# CONCEPTUAL QUESTIONS (Q1-Q7)
# ============================================================================

# Q1: Sample variance divides by n-1 ✓
# Q2: var(x) computes sample variance ✓
# Q3: cor(x, y) computes correlation ✓
# Q4: Correlation is between -1 and 1 ✓
# Q5: E[X] = sum of each value times its probability ✓
# Q6: E[X^2] = sum of each squared value times its probability ✓
# Q7: sd(x) gives SAMPLE standard deviation (divides by n-1) ✓

# ============================================================================
# CALCULATION QUESTIONS
# ============================================================================

# --- Q8: Sample Mean ---
# Formula: mean(x) = (1/n) * sum(x_i)
x <- c(1, 4, 11)
mean(x)
# Expected: 5.33

# --- Q9: Sample Variance ---
# Formula: var(x) = (1/(n-1)) * sum((x_i - mean)^2)
x <- c(9, 5, 5)
var(x)
# Expected: 5.33

# --- Q10: Sample Standard Deviation ---
# Formula: sd(x) = sqrt(var(x))
x <- c(7, 2, 4)
sd(x)
# Expected: 2.52

# --- Q11: Sample Covariance ---
# Formula: cov(x, y) = (1/(n-1)) * sum((x_i - mean(x)) * (y_i - mean(y)))
x <- c(2, 4, 1)
y <- c(6, 6, 3)
cov(x, y)
# Expected: 2

# --- Q12: Sample Correlation from Statistics ---
# Formula: cor = cov(x,y) / (sd(x) * sd(y))
S_xy <- -4
S_x <- 4
S_y <- 4
rho <- S_xy / (S_x * S_y)
round(rho, 2)
# Expected: -0.25

# --- Q13: Sample Correlation Directly from Data ---
# Formula: cor(x, y) - correlation coefficient
x <- c(2, 6, 1)
y <- c(5, 8, 5)
cor(x, y)
# Expected: 0.98

