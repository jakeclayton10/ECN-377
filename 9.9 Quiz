# --- Q14: Expected Value for Fair Coin (2 on heads, 0 on tails) ---
# E[X] = sum(value * probability)
values <- c(2, 0)
probs <- c(0.5, 0.5)
E_X <- sum(values * probs)
round(E_X, 2)
# Expected: 1

# --- Q15: E[X^2] for Fair Coin (7 on heads, 9 on tails) ---
# E[X^2] = sum(value^2 * probability)
values <- c(7, 9)
probs <- c(0.5, 0.5)
E_X2 <- sum(values^2 * probs)
round(E_X2, 2)
# Expected: 65

