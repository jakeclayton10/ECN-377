# Round to hundredths as needed

# ============================================================================
# CONCEPTUAL QUESTIONS (Q1-Q8)
# ============================================================================

# Q1: Fitted value Y_hat_i = beta_0 + beta_1 * X_i is the model's PREDICTION of Y at X_i ✓
# Q2: OLS residual U_hat_i equals Y_i - Y_hat_i (actual minus fitted) ✓
# Q3: A POSITIVE residual means OLS under-predicted Y_i (actual > fitted) ✓
# Q4: R^2 is the fraction of sample variation in Y explained by X ✓
# Q5: Total sum of squares decomposes as SST = SSE + SSR ✓
# Q6: The sum of OLS residuals sum(U_hat_i) is always 0 ✓
# Q7: R^2 close to 0 means the OLS line explains little variation in Y ✓
# Q8: The point (X_bar, Y_bar) always lies on the OLS regression line ✓

# ============================================================================
# CALCULATION QUESTIONS
# ============================================================================

# --- Q9: OLS Slope from Sample Data ---
# Formula: beta_1 = sum((X_i - X_bar)(Y_i - Y_bar)) / sum((X_i - X_bar)^2)
x <- c(5, 5, 2)
y <- c(8, 1, 7)

X_bar <- mean(x)
Y_bar <- mean(y)
numerator <- sum((x - X_bar) * (y - Y_bar))
denominator <- sum((x - X_bar)^2)
beta_1 <- numerator / denominator
round(beta_1, 2)
# Expected: -0.83

# --- Q10: OLS Intercept from Sample Data ---
# Formula: beta_0 = Y_bar - beta_1 * X_bar
x <- c(2, 5, 7)
y <- c(4, 10, 4)

X_bar <- mean(x)
Y_bar <- mean(y)
numerator <- sum((x - X_bar) * (y - Y_bar))
denominator <- sum((x - X_bar)^2)
beta_1 <- numerator / denominator
beta_0 <- Y_bar - beta_1 * X_bar
round(beta_0, 2)
# Expected: 5.26

# --- Q11: Fit OLS Line and Predict at x = 2 ---
x <- c(7, 5, 1)
y <- c(12, 7, 0)

X_bar <- mean(x)
Y_bar <- mean(y)
numerator <- sum((x - X_bar) * (y - Y_bar))
denominator <- sum((x - X_bar)^2)
beta_1 <- numerator / denominator
beta_0 <- Y_bar - beta_1 * X_bar

# Predict at x = 2
x_pred <- 2
y_pred <- beta_0 + beta_1 * x_pred
round(y_pred, 2)
# Expected: 1.75

# --- Q12: Find Fitted Value at Given X ---
# Fitted line: y_hat = -2 + (3/10)*x
beta_0 <- -2
beta_1 <- 3/10
x <- 8
y_hat <- beta_0 + beta_1 * x
round(y_hat, 2)
# Expected: 0.4

# --- Q13: Find Residual Given Line and Point ---
# Fitted line: y_hat = -3 + (7/10)*x
# Point: x = 7, actual y = 13
beta_0 <- -3
beta_1 <- 7/10
x <- 7
y_actual <- 13
y_hat <- beta_0 + beta_1 * x
residual <- y_actual - y_hat
round(residual, 2)
# Expected: 11.1

# --- Q14: Predict Change in Y Given Slope and Change in X ---
# Formula: Delta_y_hat = beta_1 * Delta_x
beta_1 <- 5/10
delta_x <- 5
delta_y_hat <- beta_1 * delta_x
round(delta_y_hat, 2)
# Expected: 2.5

# --- Q15: Calculate SSR (Sum of Squared Residuals) ---
# Fitted line: y_hat = 3 + (8/10)*x
# Points: (4, 9), (8, 2), (3, 11)
beta_0 <- 3
beta_1 <- 8/10
x_vals <- c(4, 8, 3)
y_vals <- c(9, 2, 11)

y_hat <- beta_0 + beta_1 * x_vals
residuals <- y_vals - y_hat
SSR <- sum(residuals^2)
round(SSR, 2)
# Expected: 93.96

# --- Q16: SST = SSE + SSR, Find SSE ---
# Formula: SSE = SST - SSR
SST <- 337
SSR <- 86
SSE <- SST - SSR
round(SSE, 2)
# Expected: 251

# --- Q17: Find R^2 from SST and SSR ---
# Formula: R^2 = SSR / SST
SST <- 337
SSR <- 115
R_squared <- SSR / SST
round(R_squared, 2)
# Expected: 0.66

# --- Q18: Find R^2 from SSE and SST ---
# Formula: R^2 = (SST - SSR) / SST = 1 - (SSR / SST) = 1 - (SSE / SST)
# Wait, let me recalculate. SST = SSE + SSR, so SSR = SST - SSE
# R^2 = SSR / SST = (SST - SSE) / SST = 1 - (SSE / SST)
SSE <- 95
SST <- 310
R_squared <- 1 - (SSE / SST)
round(R_squared, 2)
# Expected: 0.31

# --- Q19: Find Unexplained Fraction of Variation ---
# Formula: Unexplained = 1 - R^2 = SSR / SST
SST <- 239
SSR <- 111
unexplained <- SSR / SST
round(unexplained, 2)
# Expected: 0.46

# --- Q20: Find SSR from SST and R^2 ---
# Formula: R^2 = SSR / SST, so SSR = R^2 * SST
SST <- 291
R_squared <- 42/100
SSR <- R_squared * SST
round(SSR, 2)
# Expected: 168.78
