# ---------------------------------------------------------------------
# #15  Change in predicted Y when ONE variable changes, others fixed
#      dY = b_var * dvar
# ---------------------------------------------------------------------
dat15 <- wage1                          # PLUG IN dataset
f15   <- wage ~ educ + exper + tenure   # PLUG IN formula
var15 <- "tenure"                       # PLUG IN the variable that changes
dx15  <- 3                              # PLUG IN how much it changes

reg15 <- lm(f15, data = dat15)
cat("Q15 coefficient on", var15, "=", round(coef(reg15)[var15], 4), "\n")
r2("Q15 ANSWER: change in predicted Y", coef(reg15)[var15] * dx15)
# If Y is log(y), the % change is 100 * coef * dx15.


# ---------------------------------------------------------------------
# EXTRA  General regression tools (n, SSR, sigma-hat, R-squared, std. errors)
# ---------------------------------------------------------------------
datG <- wage1          # PLUG IN dataset
fG   <- wage ~ educ    # PLUG IN formula

regG <- lm(fG, data = datG)
print(summary(regG))           # coefficients, Std. Error, R-squared
nG    <- nobs(regG)
ssrG  <- sum(resid(regG)^2)
sigG  <- sqrt(ssrG / (nG - length(coef(regG))))
r2("n", nG); r2("SSR", ssrG); r2("sigma-hat", sigG)
r2("R-squared", summary(regG)$r.squared)
