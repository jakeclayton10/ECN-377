# ---------------------------------------------------------------------
# #6  CONCEPT: what makes Var(b1) = sigma^2 / SST_X LARGER? (select all)
#     YES: smaller sample (smaller SST_X)
#     YES: larger error variance sigma^2
#     YES: X bunched tightly together (smaller SST_X)
#     NO : larger sample, larger true slope beta1 (beta1 not in formula)
#     If the quiz asks what makes it SMALLER, flip it: bigger n,
#     smaller sigma^2, X more spread out.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# #7  se(b1) from sigma-hat, n and the STANDARD DEVIATION of X
#     SST_X = (n-1) * S_X^2 ;  se = sigma_hat / sqrt(SST_X)
# ---------------------------------------------------------------------
n7     <- 8      # PLUG IN n
sig7   <- 2.1    # PLUG IN sigma-hat
sdX7   <- 0.7    # PLUG IN S_X (standard deviation of X)

sst7 <- (n7 - 1) * sdX7^2
r2("Q7 SST_X", sst7)
r2("Q7 ANSWER: se(b1)", sig7 / sqrt(sst7))
# If they give the VARIANCE of X instead, use sst7 <- (n7 - 1) * varX
# If they give SSR instead of sigma-hat, use sig7 <- sqrt(SSR / (n7 - 2))


# ---------------------------------------------------------------------
# #9  sd(b1) when the sample (and SST_X) gets k times as large
#     new sd = old sd / sqrt(k)
# ---------------------------------------------------------------------
sd9 <- 0.38    # PLUG IN current sd(b1)
k9  <- 16      # PLUG IN "k times as large"

r2("Q9 ANSWER: new sd(b1)", sd9 / sqrt(k9))
# If sigma doubles instead, sd doubles. If SST_X shrinks by k, multiply by sqrt(k).


