if (!require(wooldridge)) install.packages("wooldridge")
library(wooldridge)

r2 <- function(label, x) cat(label, "=", format(round(x, 2), nsmall = 2), "\n")


# ---------------------------------------------------------------------
# #1  INTERPRET A SLOPE (which functional form is it?)
#     Run this block to print the right sentence for any slope b.
#
#     level-level  y ~ x           : $1 / 1-unit rise in x -> y changes b UNITS
#     level-log    y ~ log(x)      : 1% rise in x -> y changes b/100 UNITS
#     log-level    log(y) ~ x      : 1-unit rise in x -> y changes 100*b PERCENT
#     log-log      log(y) ~ log(x) : 1% rise in x -> y changes b PERCENT
#
#     Practice version: test score = 12 + 8 log(income) is level-log, so
#     ANSWER: "A 1% rise in income ... rise of about 0.08 points."
# ---------------------------------------------------------------------
b1_q1    <- 8             # PLUG IN the slope
form_q1  <- "level-log"   # PLUG IN "level-level", "level-log", "log-level", or "log-log"

if (form_q1 == "level-level") cat("Q1 ANSWER: 1-unit rise in x ->", b1_q1, "unit change in y\n")
if (form_q1 == "level-log")   cat("Q1 ANSWER: 1% rise in x ->", b1_q1 / 100, "unit change in y\n")
if (form_q1 == "log-level")   cat("Q1 ANSWER: 1-unit rise in x ->", 100 * b1_q1, "% change in y\n")
if (form_q1 == "log-log")     cat("Q1 ANSWER: 1% rise in x ->", b1_q1, "% change in y\n")


# ---------------------------------------------------------------------
# #2  LOG-LEVEL: % change in y when x changes by some amount
#     log(y) = b0 + b1*x  ->  %dY ~ 100 * b1 * dX
#     A FALL in x means dX is NEGATIVE (type the minus sign).
# ---------------------------------------------------------------------
b1_q2 <- 0.05    # PLUG IN slope on x
dx_q2 <- -3      # PLUG IN change in x (falls by 3 -> -3)

r2("Q2 ANSWER: % change in y", 100 * b1_q2 * dx_q2)
# Exact version (only if they ask for it): 100 * (exp(b1_q2 * dx_q2) - 1)


# ---------------------------------------------------------------------
# #3  LOG-LOG: % change in Y when X rises by some %
#     lm(log(y) ~ log(x)) -> %dY ~ b1 * %dX
# ---------------------------------------------------------------------
dat3   <- bwght        # PLUG IN dataset
y3     <- "bwght"      # PLUG IN Y variable
x3     <- "faminc"     # PLUG IN X variable
pct_x3 <- 20           # PLUG IN % rise in X (20 for 20%)

reg3 <- lm(as.formula(paste0("log(", y3, ") ~ log(", x3, ")")), data = dat3)
b3   <- coef(reg3)[2]
cat("Q3 slope (elasticity) =", round(b3, 4), "\n")
r2("Q3 ANSWER: % change in Y", b3 * pct_x3)

# Other functional forms, in case the quiz swaps it:
#   log-level  lm(log(y) ~ x):  %dY = 100 * b1 * dX
#   level-log  lm(y ~ log(x)):  dY  = (b1/100) * %dX
#   level-level lm(y ~ x):      dY  = b1 * dX


