# ============================================================================
# Q14: STANDARD DEVIATION OF SLOPE ESTIMATOR
# ============================================================================
# ORIGINAL QUESTION:
# "Under SLR1–SLR5, the error standard deviation is σ = 2.
#  A sample has X values x = (1, 7, 8, 9, 10).
#  Find sd(β̂₁)."
# ANSWER: 0.28

# Formula: sd(β̂₁) = σ / sqrt(SST_X)
# SST_X = Σ(x_i - x̄)²

# Original calculation:
sigma <- 2
x_original <- c(1, 7, 8, 9, 10)
x_bar <- mean(x_original)
SST_X <- sum((x_original - x_bar)^2)
sd_beta_1_original <- sigma / sqrt(SST_X)
round(sd_beta_1_original, 2)
# Result: 0.28

# PLUG AND PLAY TEMPLATE:
