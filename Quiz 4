# --- Q15: Covariance Cov(X, Y) = E[XY] - E[X]E[Y] ---
E_XY <- 26
E_X <- 3
E_Y <- 1
Cov_XY <- E_XY - E_X * E_Y
round(Cov_XY, 2)
# Expected: 23.00

# --- Q16: Covariance from Paired Data ---
# X and Y: (3,1), (2,1), (5,1) each with prob 1/3
X_values <- c(3, 2, 5)
Y_values <- c(1, 1, 1)
probs <- c(1/3, 1/3, 1/3)

E_X <- sum(X_values * probs)
E_Y <- sum(Y_values * probs)
E_XY <- sum(X_values * Y_values * probs)
Cov_XY <- E_XY - E_X * E_Y
round(Cov_XY, 2)
# Expected: 0.00

# --- Q17: Covariance Property Cov(a1*X + b1, a2*Y + b2) = a1*a2*Cov(X,Y) ---
Cov_XY <- -3
a1 <- 3
a2 <- 5
# Constants b1, b2 don't matter
Cov_transformed <- a1 * a2 * Cov_XY
round(Cov_transformed, 2)
# Expected: -45.00

# --- Q18: Correlation Cor(X, Y) = Cov(X, Y) / (sd(X) * sd(Y)) ---
Cov_XY <- 4
sd_X <- 3
sd_Y <- 2
Cor_XY <- Cov_XY / (sd_X * sd_Y)
round(Cor_XY, 2)
# Expected: 0.67

# --- Q19: Variance of Linear Combination ---
# Var(aX + bY) = a^2*Var(X) + b^2*Var(Y) + 2*a*b*Cov(X,Y)
Var_X <- 2
Var_Y <- 5
Cov_XY <- 0
a <- 3
b <- 1
Var_aX_plus_bY <- a^2 * Var_X + b^2 * Var_Y + 2 * a * b * Cov_XY
round(Var_aX_plus_bY, 2)
# Expected: 23.00

# --- Q20: Conditional Expectation E[Y | X = x] (Subgroup Average) ---
# Y values: 2, 3, 6, 12 (all equally likely)
Y_values <- c(2, 3, 6, 12)
E_Y_given_X <- mean(Y_values)
round(E_Y_given_X, 2)
